{
	"name": "udv-sus-mobile",
	"main": "expo-router/entry",
	"version": "1.1.0",
	"iosBuildNumber": "3",
	"scripts": {
		"start": "expo start -c",
		"bump": "node ./scripts/bump-version.mjs",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "cd android && ./gradlew clean && cd ../ && expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"test": "jest --watchAll",
		"lint": "expo lint",
		"apk": "cd android && ./gradlew assembleRelease && cp ./app/build/outputs/apk/release/app-release.apk ../ && cd ../",
		"apkClean": "cd android && ./gradlew clean && ./gradlew assembleRelease && cp ./app/build/outputs/apk/release/app-release.apk ../ && cd ../",
		"bac": "npx expo prebuild --platform android --clean",
		"ba": "npx expo prebuild --platform android",
		"generate": "npx expo prebuild && cp android/app/build.gradle support-files/build.gradle"
	},
	"jest": {
		"preset": "jest-expo"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.0.2",
		"@hookform/resolvers": "^3.9.1",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "8.4.4",
		"@react-native-picker/picker": "2.11.1",
		"@react-navigation/bottom-tabs": "^7.0.0",
		"@react-navigation/drawer": "7.7.10",
		"@react-navigation/native": "^7.0.0",
		"@rn-primitives/slot": "^1.1.0",
		"@rn-primitives/types": "^1.1.0",
		"@tanstack/react-query": "^5.62.7",
		"axios": "^1.7.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"dotenv": "^17.2.0",
		"expo": "^54.0.0",
		"expo-auth-session": "~7.0.8",
		"expo-constants": "~18.0.9",
		"expo-font": "~14.0.9",
		"expo-haptics": "~15.0.7",
		"expo-linking": "~8.0.8",
		"expo-router": "~6.0.12",
		"expo-secure-store": "~15.0.7",
		"expo-splash-screen": "~31.0.10",
